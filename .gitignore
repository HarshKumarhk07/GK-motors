# Env files, backups and local overrides.
# .env.example is untracked too, at the repo owner's request — so the
# required variable names are documented in AGENTS.md section 8 instead.
.env.bak
.env.backup*
.env.local
.env.*.local
server/.env.backup*
client/.env.backup*
.env.example
.env.backup

# Scratch folder for files staged for deletion. Nothing in here is part of the
# project — it exists because the remote session can move files but not delete
# them, so anything on its way out gets parked here first. Safe to empty.
_to_delete/

# Full-resolution generated artwork. Kept for re-encoding, never deployed —
# anything under client/public is copied verbatim into the build.
client/design-source/
